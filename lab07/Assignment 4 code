#include <stdio.h>

void swap(int arr[], int i, int j) {
    int temp = arr[i];
    arr[i] = arr[j];
    arr[j] = temp;
}

void bubbleSort(int arr[], int size) {
    if (size <= 1) return;
    for (int i = 0; i < size - 1; i++) {
        int swapped = 0;
        for (int j = 0; j < size - 1 - i; j++) {
            if (arr[j] > arr[j + 1]) {
                int temp = arr[j];
                arr[j] = arr[j + 1];
                arr[j + 1] = temp;
                swapped = 1;
            }
        }
        if (swapped == 0) break;
    }
}

void merge(int arr[], int left, int mid, int right) {
    int i, j, k;
    int n1 = mid - left + 1;
    int n2 = right - mid;
    int L[n1], R[n2];
    for (i = 0; i < n1; i++) L[i] = arr[left + i];
    for (j = 0; j < n2; j++) R[j] = arr[mid + 1 + j];
    i = 0; j = 0; k = left;
    while (i < n1 && j < n2) {
        if (L[i] <= R[j]) {
            arr[k] = L[i];
            i++;
        } else {
            arr[k] = R[j];
            j++;
        }
        k++;
    }
    while (i < n1) { arr[k] = L[i]; i++; k++; }
    while (j < n2) { arr[k] = R[j]; j++; k++; }
}

void mergeSortHelper(int arr[], int left, int right) {
    if (left < right) {
        int mid = left + (right - left) / 2;
        mergeSortHelper(arr, left, mid);
        mergeSortHelper(arr, mid + 1, right);
        merge(arr, left, mid, right);
    }
}

void mergeSort(int arr[], int size) {
    if (size > 1) mergeSortHelper(arr, 0, size - 1);
}

int partition(int arr[], int low, int high) {
    int pivot = arr[high];
    int i = (low - 1);
    for (int j = low; j < high; j++) {
        if (arr[j] <= pivot) {
            i++;
            swap(arr, i, j);
        }
    }
    swap(arr, i + 1, high);
    return (i + 1);
}

void quickSortHelper(int arr[], int low, int high) {
    if (low < high) {
        int pi = partition(arr, low, high);
        quickSortHelper(arr, low, pi - 1);
        quickSortHelper(arr, pi + 1, high);
    }
}

void quickSort(int arr[], int size) {
    if (size > 1) quickSortHelper(arr, 0, size - 1);
}

void insertionSort(int arr[], int size) {
    if (size < 2) return;
    for (int i = 1; i < size; i++) {
        int key = arr[i];
        int j = i - 1;
        while (j >= 0 && arr[j] > key) {
            arr[j + 1] = arr[j];
            j = j - 1;
        }
        arr[j + 1] = key;
    }
}

void selectionSort(int arr[], int size) {
    if (size < 2) return;
    for (int i = 0; i < size - 1; i++) {
        int min_idx = i;
        for (int j = i + 1; j < size; j++) {
            if (arr[j] < arr[min_idx]) min_idx = j;
        }
        if (min_idx != i) swap(arr, i, min_idx);
    }
}

void insertionSortRange(int arr[], int left, int right) {
    for (int i = left + 1; i <= right; i++) {
        int key = arr[i];
        int j = i - 1;
        while (j >= left && arr[j] > key) {
            arr[j + 1] = arr[j];
            j = j - 1;
        }
        arr[j + 1] = key;
    }
}

void hybridMergeSortHelper(int arr[], int left, int right, int k) {
    if (right - left + 1 <= k) {
        insertionSortRange(arr, left, right);
    } else if (left < right) {
        int mid = left + (right - left) / 2;
        hybridMergeSortHelper(arr, left, mid, k);
        hybridMergeSortHelper(arr, mid + 1, right, k);
        merge(arr, left, mid, right);
    }
}

void hybridSort(int arr[], int size, int k) {
    if (size > 1) hybridMergeSortHelper(arr, 0, size - 1, k);
}

int main() {
    int test_arr[] = {39, 9, 81, 45, 90, 27, 72, 18};
    int n = sizeof(test_arr) / sizeof(test_arr[0]);
    int k = 4;

    printf("Original array: ");
    for(int i=0; i<n; i++) printf("%d ", test_arr[i]);

    hybridSort(test_arr, n, k);

    printf("\nSorted array (Hybrid Sort): ");
    for(int i=0; i<n; i++) printf("%d ", test_arr[i]);
    printf("\n");

    return 0;
}
